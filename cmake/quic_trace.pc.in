prefix=${pcfiledir}/../..
libdir=${prefix}/lib
includedir=${prefix}/include

Name: quic_trace
Description: C++ QUIC transport tracing facade and LTTng provider
Version: @PROJECT_VERSION@
Requires: lttng-ust >= 2.13
Libs: -L${libdir} -lquic_trace_provider -Wl,-u,__start_lttng_ust_tracepoints_ptrs
Cflags: -I${includedir}
