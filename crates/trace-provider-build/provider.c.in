/*
 * The native half of one LTTng-UST provider, shared by every provider.
 *
 * Both Cargo, through trace-provider-build, and CMake, through configure_file,
 * substitute the provider name for each @PROVIDER@ marker, so the two builds
 * compile the same source. Everything a provider declares lives beside its
 * interface.h: the schema in events.tp and the event list in events.inc.
 */
#include "interface.h"

#define LTTNG_UST_TRACEPOINT_DEFINE
#define LTTNG_UST_TRACEPOINT_CREATE_PROBES
#include "events.h"

#if defined(__has_attribute)
#	if __has_attribute(retain)
#		define TRACE_PROVIDER_RETAIN __attribute__((retain))
#	endif
#endif

#ifndef TRACE_PROVIDER_RETAIN
#	define TRACE_PROVIDER_RETAIN
#endif

/*
 * LTTng-UST discovers tracepoints through the linker-synthesized
 * __start/__stop_lttng_ust_tracepoints_ptrs symbols. LLD does not treat those
 * symbols as roots under --gc-sections (its default --start-stop-gc behaviour)
 * and rustc links with LLD, so the section is collected and the provider
 * registers nothing while `lttng list` still advertises every event. An
 * exported, linker-retained reference to each pointer holds the section in
 * place under both LLD and GNU ld.
 *
 * The entries come from events.inc, so an event added there cannot be left out
 * of the retained set. A missing entry drops the event from a capture while
 * `lttng list` still reports it.
 */
TRACE_PROVIDER_RETAIN __attribute__((used, visibility("default"))) void *const @PROVIDER@_tracepoints[] = {
#define EVENT(name) &lttng_ust_tracepoint_ptr_@PROVIDER@___##name,
#include "events.inc"
};
#undef EVENT

/*
 * Tracepoints register from a constructor in the generated events.h. Every
 * hook calls the wrappers below, which live in this object, so referencing any
 * of them keeps the constructor linked.
 *
 * Every wrapper comes from events.inc for the same reason. The enablement
 * predicate is a plain function for the facade to call, and it reads one state
 * word, so a disabled event never enters the tracepoint.
 */
#define EVENT(name) \
	bool @PROVIDER@_##name##_enabled(void) { \
		return lttng_ust_tracepoint_enabled(@PROVIDER@, name); \
	} \
	void @PROVIDER@_##name(const struct @PROVIDER@_##name *event) { \
		lttng_ust_tracepoint(@PROVIDER@, name, event); \
	}

#include "events.inc"

#undef EVENT
