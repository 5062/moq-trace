		lttng_ust_field_integer(uint64_t, local_address_low, event->local_address_low)
		lttng_ust_field_integer(uint16_t, local_port, event->local_port)
		lttng_ust_field_integer(uint64_t, peer_address_high, event->peer_address_high)
		lttng_ust_field_integer(uint64_t, peer_address_low, event->peer_address_low)
		lttng_ust_field_integer(uint16_t, peer_port, event->peer_port)
	)
)

LTTNG_UST_TRACEPOINT_EVENT(quic_trace, udp_socket_start,
	LTTNG_UST_TP_ARGS(const struct quic_trace_udp_socket_start *, event),
	LTTNG_UST_TP_FIELDS(
		lttng_ust_field_integer(uint64_t, timestamp_ns, event->timestamp_ns)
		lttng_ust_field_integer(uint64_t, trace_id, event->trace_id)
		lttng_ust_field_integer(uint8_t, has_connection_id, event->has_connection_id)
		lttng_ust_field_integer(uint64_t, connection_id, event->connection_id)
		lttng_ust_field_enum(quic_trace, direction, uint8_t, direction, event->direction)
	)
)

LTTNG_UST_TRACEPOINT_EVENT(quic_trace, udp_socket_end,
	LTTNG_UST_TP_ARGS(const struct quic_trace_udp_socket_end *, event),
	LTTNG_UST_TP_FIELDS(
		lttng_ust_field_integer(uint64_t, timestamp_ns, event->timestamp_ns)
		lttng_ust_field_integer(uint64_t, trace_id, event->trace_id)
		lttng_ust_field_enum(quic_trace, socket_outcome, uint8_t, outcome, event->outcome)
		lttng_ust_field_integer(uint64_t, buffers, event->buffers)
		lttng_ust_field_integer(uint64_t, datagrams, event->datagrams)
		lttng_ust_field_integer(uint64_t, bytes, event->bytes)
	)
)
