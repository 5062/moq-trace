		lttng_ust_field_integer(uint64_t, span_id, event->span_id)
		lttng_ust_field_enum(quic_trace, packet_phase, uint8_t, phase, event->phase)
		lttng_ust_field_enum(quic_trace, edge, uint8_t, edge, event->edge)
		lttng_ust_field_integer(uint8_t, has_outcome, event->has_outcome)
		lttng_ust_field_enum(quic_trace, packet_outcome, uint8_t, outcome, event->outcome)
	)
)

LTTNG_UST_TRACEPOINT_EVENT(quic_trace, quic_stream_frame,
	LTTNG_UST_TP_ARGS(const struct quic_trace_quic_stream_frame *, event),
